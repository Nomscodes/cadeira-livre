# =============================================================================
# Cadeira Livre - Modelo de variáveis de ambiente
# =============================================================================
#
# Como usar:
#   1. Copie este arquivo para um novo arquivo chamado .env (na mesma pasta).
#   2. Preencha os valores marcados como <preencher> com os dados reais.
#   3. NUNCA versione o arquivo .env. Ele já está no .gitignore.
#
# Este arquivo contém apenas nomes e exemplos. Não coloque senhas, chaves
# ou tokens reais aqui.
# =============================================================================


# -----------------------------------------------------------------------------
# DATABASE_URL
# Endereço de conexão com o banco PostgreSQL usado pela API.
# Formato: postgresql://USUARIO:SENHA@HOST:PORTA/NOME_DO_BANCO
# Em desenvolvimento local com Docker Compose, o host costuma ser "localhost".
# Em produção (Railway), o valor é fornecido pelo próprio serviço de banco.
# -----------------------------------------------------------------------------
DATABASE_URL=postgresql://<usuario>:<senha>@localhost:5432/cadeira_livre


# -----------------------------------------------------------------------------
# JWT_SECRET
# Chave secreta usada para assinar e validar os tokens de autenticação (JWT).
# Quem conhece esta chave consegue forjar tokens, então deve ser longa e
# aleatória, com pelo menos 32 caracteres.
# Para gerar um valor seguro (com o Git para Windows instalado):
#   openssl rand -base64 32
# Cada ambiente (desenvolvimento e produção) deve ter a sua própria chave.
# -----------------------------------------------------------------------------
JWT_SECRET=<gerar-com-openssl-rand-base64-32>


# -----------------------------------------------------------------------------
# API_KEYS
# Chaves de acesso a serviços externos, como a API de mapas (Google Maps).
# Se houver mais de uma chave, separe-as por vírgula, sem espaços.
# Formato: CHAVE_1,CHAVE_2
# Deixe vazio se nenhum serviço externo estiver configurado.
# -----------------------------------------------------------------------------
API_KEYS=<preencher-se-houver>


# -----------------------------------------------------------------------------
# PORT
# Porta em que a API REST será executada.
# Padrão de desenvolvimento: 8080. Em produção, o Railway define a porta
# automaticamente e este valor é ignorado.
# -----------------------------------------------------------------------------
PORT=8080
