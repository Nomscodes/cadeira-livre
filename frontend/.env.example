# Como usar: copie este arquivo para ".env" (na pasta frontend) e ajuste os valores.
# O arquivo .env nao vai para o repositorio.

# false = chama o backend real (a API precisa estar rodando em VITE_API_URL).
# true  = usa a API simulada (src/mocks), sem backend.
# Os testes (npm test) usam sempre a API simulada, nao importa o valor daqui.
VITE_USE_MOCK=true

# URL base do backend Spring Boot (usada quando VITE_USE_MOCK=false).
VITE_API_URL=http://localhost:8080/api

# Opcional: link do canal de suporte exibido em Configuracoes.
VITE_SUPPORT_URL=

# Recursos SO PARA TESTE (barra de navegacao do prototipo e atalho de edicao de horarios na tela do funcionario).
# So funcionam com VITE_USE_MOCK=true. No arquivo de DEPLOY use VITE_MODO_TESTE=false.
VITE_MODO_TESTE=true
VITE_PROTO_BAR=true
